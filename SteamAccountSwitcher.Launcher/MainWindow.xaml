<Window x:Class="SteamAccountSwitcher.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SteamAccountSwitcher.Launcher.ViewModels"
        mc:Ignorable="d"
        Title="Steam Account Switcher Pro"
        Height="720" Width="1060"
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <!-- Main Outer Window Border -->
    <Border Background="{StaticResource BrushBgDeep}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="0" Opacity="0.7" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" /> <!-- Custom Title Bar -->
                <RowDefinition Height="Auto" /> <!-- Search and Quick Actions Bar -->
                <RowDefinition Height="*" /> <!-- Account List -->
                <RowDefinition Height="32" /> <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- 1. Custom Title Bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource BrushBgHeader}"
                    CornerRadius="9,9,0,0"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,0,1"
                    MouseDown="TitleBar_MouseDown">
                <Grid Margin="16,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Title & Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="13" Background="#1b2838" BorderBrush="{StaticResource BrushAccentCyan}" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="🎮" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="STEAM LAUNCHER" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushAccentCyan}" VerticalAlignment="Center" />
                        <Border Margin="8,0,0,0" Background="#1f6feb" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="PRO" FontSize="10" FontWeight="Bold" Foreground="#ffffff" />
                        </Border>
                    </StackPanel>

                    <!-- Window Control Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="BtnMinimize_Click" Width="36" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="2,0">
                            <TextBlock Text="—" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button Click="BtnMaximize_Click" Width="36" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="2,0">
                            <TextBlock Text="◻" Foreground="{StaticResource BrushTextSecondary}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button Click="BtnClose_Click" Width="36" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="2,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                                    <TextBlock x:Name="txt" Text="✕" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#da3633" />
                                                        <Setter TargetName="txt" Property="Foreground" Value="#ffffff" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Search, Filter Tabs & Quick Action Bar -->
            <Border Grid.Row="1" Background="#11161d" Padding="16,12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Row: Search Box & Quick Tools -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Search Box -->
                        <Grid Grid.Column="0">
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="32,7,10,7" />
                            <TextBlock Text="🔍" FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" />
                            <TextBlock Text="Hesap adı, etiket veya not ara..."
                                       FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center" Margin="34,0,0,0" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Quick Actions Group -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource ModernButton}" Command="{Binding RefreshCommand}" Margin="4,0" ToolTip="Listeyi Yenile">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄" Margin="0,0,6,0" />
                                    <TextBlock Text="Yenile" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource ModernButton}" Command="{Binding AddNewAccountCommand}" Margin="4,0" ToolTip="Yeni bir Steam hesabı eklemek için giriş ekranını açar">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➕" Margin="0,0,6,0" />
                                    <TextBlock Text="Hesap Ekle" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource ModernButton}" Command="{Binding RestartSteamCommand}" Margin="4,0" ToolTip="Steam'i Yeniden Başlat">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" Margin="0,0,6,0" />
                                    <TextBlock Text="Steam Yeniden Başlat" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource ModernButton}" Command="{Binding KillSteamCommand}" Margin="4,0" ToolTip="Steam'i Zorla Kapat">
                                <TextBlock Text="🛑 Kapat" Foreground="#f85149" />
                            </Button>

                            <Button Style="{StaticResource ModernButton}" Command="{Binding OpenUserDataFolderCommand}" Margin="4,0" ToolTip="Userdata / Ekran Görüntüleri Klasörünü Aç">
                                <TextBlock Text="📁 Klasör" />
                            </Button>

                            <Button Style="{StaticResource ModernButton}" Command="{Binding ToggleSettingsCommand}" Margin="4,0" ToolTip="Ayarlar &amp; Yapılandırma">
                                <TextBlock Text="⚙️ Ayarlar" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Bottom Row: Filter Tabs -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <!-- All Accounts Tab -->
                        <RadioButton GroupName="FilterTabs" IsChecked="True" Cursor="Hand" Margin="0,0,10,0"
                                     Click="FilterAll_Click">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="tb" Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,5" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                        <TextBlock Text="Tüm Hesaplar" Foreground="{StaticResource BrushTextPrimary}" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="tb" Property="Background" Value="#1f6feb" />
                                            <Setter TargetName="tb" Property="BorderBrush" Value="#388bfd" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="tb" Property="Background" Value="#161b22" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Favorites Tab -->
                        <RadioButton GroupName="FilterTabs" Cursor="Hand" Margin="0,0,10,0"
                                     Click="FilterFav_Click">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="tb" Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,5" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                        <TextBlock Text="★ Favoriler" Foreground="#e3b341" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="tb" Property="Background" Value="#8250df" />
                                            <Setter TargetName="tb" Property="BorderBrush" Value="#a371f7" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="tb" Property="Background" Value="#161b22" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <!-- Active Account Tab -->
                        <RadioButton GroupName="FilterTabs" Cursor="Hand" Margin="0,0,10,0"
                                     Click="FilterActive_Click">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="tb" Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,5" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                        <TextBlock Text="🟢 Aktif Oturum" Foreground="#3fb950" FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="tb" Property="Background" Value="#238636" />
                                            <Setter TargetName="tb" Property="BorderBrush" Value="#2ea44f" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="tb" Property="Background" Value="#161b22" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Account List Body -->
            <Grid Grid.Row="2">
                <!-- Empty State Message -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Accounts.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="👻" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="Hesap bulunamadı veya Steam yüklü değil." Foreground="{StaticResource BrushTextSecondary}" FontSize="15" HorizontalAlignment="Center" />
                    <TextBlock Text="Steam'de oturum açıp 'Beni Hatırla'yı işaretledikten sonra 'Yenile' butonuna basabilirsiniz." Foreground="{StaticResource BrushTextSecondary}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Scrollable Account Cards -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,14">
                    <ItemsControl ItemsSource="{Binding Accounts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Account Card -->
                                <Border Margin="0,0,0,10"
                                        Background="{StaticResource BrushBgCard}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,12">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrentlyActive}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#2ea44f" />
                                                    <Setter Property="Background" Value="#13231b" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="#8b949e" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /> <!-- Avatar -->
                                            <ColumnDefinition Width="*" />    <!-- Details -->
                                            <ColumnDefinition Width="Auto" /> <!-- Actions -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar Column -->
                                        <Grid Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <!-- Fallback Letter Avatar -->
                                            <Border Width="52" Height="52" CornerRadius="26" Background="#21262d" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                                <TextBlock Text="{Binding AvatarInitial}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushAccentCyan}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Image Avatar (if available) -->
                                            <Border Width="52" Height="52" CornerRadius="26" ClipToBounds="True" Visibility="{Binding AvatarUrl, Converter={StaticResource StringNotEmptyToVis}}">
                                                <Image Source="{Binding AvatarUrl, Converter={StaticResource StringToImage}}" Stretch="UniformToFill" />
                                            </Border>

                                            <!-- VAC Ban Badge -->
                                            <Border Visibility="{Binding IsVacBanned, Converter={StaticResource BoolToVis}}"
                                                    Background="{StaticResource BrushDanger}"
                                                    CornerRadius="4" Padding="3,1"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4">
                                                <TextBlock Text="VAC" FontSize="9" FontWeight="Bold" Foreground="#ffffff" />
                                            </Border>
                                        </Grid>

                                        <!-- Account Details Column -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <!-- Display Name & Badges -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />

                                                <!-- Active Badge -->
                                                <Border Visibility="{Binding IsCurrentlyActive, Converter={StaticResource BoolToVis}}"
                                                        Background="#238636" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🟢" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="AKTİF OTURUM" FontSize="10" FontWeight="Bold" Foreground="#ffffff" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Custom Tag Badge -->
                                                <Border Visibility="{Binding CustomTag, Converter={StaticResource StringNotEmptyToVis}}"
                                                        Background="{Binding TagColor, Converter={StaticResource HexToBrush}}"
                                                        CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CustomTag}" FontSize="10" FontWeight="Bold" Foreground="#0d1117" VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Level Badge -->
                                                <Border Background="#30363d" CornerRadius="4" Padding="5,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="-1">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <Trigger Property="Visibility" Value="Visible">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Level, StringFormat='Lvl {0}'}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Account ID & SteamID64 -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="@" Foreground="{StaticResource BrushAccentCyan}" FontSize="12" />
                                                <TextBlock Text="{Binding AccountName}" Foreground="{StaticResource BrushAccentCyan}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text=" • SteamID: " Foreground="{StaticResource BrushTextSecondary}" FontSize="12" />
                                                <TextBlock Text="{Binding SteamId64}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" />
                                            </StackPanel>

                                            <!-- Custom Note (if any) -->
                                            <TextBlock Text="{Binding CustomNote}"
                                                       Visibility="{Binding CustomNote, Converter={StaticResource StringNotEmptyToVis}}"
                                                       Foreground="#ffd33d" FontSize="12" FontStyle="Italic" Margin="0,0,0,4" />

                                            <!-- Last Login -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Son Giriş: " Foreground="{StaticResource BrushTextSecondary}" FontSize="11" />
                                                <TextBlock Text="{Binding LastLoginFormatted}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Actions Column -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Favorite Star Button -->
                                            <Button Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="2,0" Padding="6" ToolTip="Favorilere Ekle / Çıkar">
                                                <TextBlock FontSize="16">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="☆" />
                                                            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                    <Setter Property="Text" Value="★" />
                                                                    <Setter Property="Foreground" Value="#e3b341" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>

                                            <!-- Edit Note Button -->
                                            <Button Command="{Binding DataContext.EditAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ModernButton}" Margin="4,0" ToolTip="Hesap Notu ve Etiketi Düzenle">
                                                <TextBlock Text="📝 Not / Ayar" FontSize="12" />
                                            </Button>

                                            <!-- Copy ID Button -->
                                            <Button Command="{Binding DataContext.CopySteamIdCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ModernButton}" Margin="4,0" ToolTip="SteamID64 Kopyala">
                                                <TextBlock Text="📋 Kopyala" FontSize="12" />
                                            </Button>

                                            <!-- Open Profile Button -->
                                            <Button Command="{Binding DataContext.OpenProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ModernButton}" Margin="4,0" ToolTip="Steam Topluluk Profilini Aç">
                                                <TextBlock Text="🌐 Profil" FontSize="12" />
                                            </Button>

                                            <!-- Switch Button -->
                                            <Button Command="{Binding DataContext.SwitchAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="14,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🚀" Margin="0,0,6,0" />
                                                    <TextBlock Text="GEÇİŞ YAP" FontWeight="Bold" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 4. Status Bar -->
            <Border Grid.Row="3" Background="{StaticResource BrushBgHeader}"
                    CornerRadius="0,0,9,9" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Steam Status Indicator -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#8b949e" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSteamRunning}" Value="True">
                                            <Setter Property="Fill" Value="#3fb950" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="11" Foreground="{StaticResource BrushTextSecondary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Steam Kapalı" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSteamRunning}" Value="True">
                                            <Setter Property="Text" Value="{Binding SteamProcessId, StringFormat='Steam Çalışıyor (PID: {0})'}" />
                                            <Setter Property="Foreground" Value="#3fb950" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Active User Info in status bar -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal" Visibility="{Binding CurrentAutoLoginUser, Converter={StaticResource StringNotEmptyToVis}}">
                        <TextBlock Text="Aktif Oturum: " Foreground="{StaticResource BrushTextSecondary}" FontSize="11" />
                        <TextBlock Text="{Binding CurrentAutoLoginUser}" Foreground="{StaticResource BrushAccentCyan}" FontSize="11" FontWeight="Bold" />
                    </StackPanel>

                    <!-- Total Accounts Count -->
                    <TextBlock Grid.Column="2" Text="{Binding Accounts.Count, StringFormat='Toplam {0} Hesap'}"
                               Foreground="{StaticResource BrushTextSecondary}" FontSize="11" />
                </Grid>
            </Border>

            <!-- MODAL 1: Account Edit Popup -->
            <Border Grid.Row="0" Grid.RowSpan="4"
                    Background="#cc0d1117"
                    CornerRadius="10"
                    Visibility="{Binding IsEditingAccount, Converter={StaticResource BoolToVis}}"
                    Panel.ZIndex="100">
                <Border Background="{StaticResource BrushBgCard}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Width="480"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24">
                    <StackPanel>
                        <TextBlock Text="Hesap Özelleştirme" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,16" />

                        <!-- Note -->
                        <TextBlock Text="Özel Not (örn: CS2 Prime, Ana Hesap, Pazar):" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditNote, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <!-- Tag & Color -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Etiket (Tag):" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditTag, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Renk (Hex):" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditTagColor, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <!-- Custom Launch Args -->
                        <TextBlock Text="Özel Başlatma Parametresi (isteğe bağlı):" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditLaunchArgs, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <!-- Fast Game AppId -->
                        <TextBlock Text="Otomatik Başlatılacak Oyun AppID (örn: 730 for CS2):" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditFastLaunchAppId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" />

                        <!-- Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource ModernButton}" Command="{Binding CancelAccountEditCommand}" Content="Vazgeç" Margin="0,0,8,0" />
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveAccountEditCommand}" Content="Değişiklikleri Kaydet" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- MODAL 2: Settings Popup -->
            <Border Grid.Row="0" Grid.RowSpan="4"
                    Background="#cc0d1117"
                    CornerRadius="10"
                    Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}"
                    Panel.ZIndex="101">
                <Border Background="{StaticResource BrushBgCard}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Width="520"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24">
                    <StackPanel>
                        <TextBlock Text="Uygulama Ayarları" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,16" />

                        <!-- Steam Web API Key -->
                        <TextBlock Text="Steam Web API Anahtarı (Avatarlar ve VAC durumu için opsiyonel):" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding SteamApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                        <TextBlock Foreground="{StaticResource BrushAccentCyan}" FontSize="11" Margin="0,0,0,14" Cursor="Hand" MouseDown="SteamApiKeyLink_MouseDown">
                            <Underline>Buraya tıklayarak Steam API anahtarınızı ücretsiz alabilirsiniz.</Underline>
                        </TextBlock>

                        <!-- Toggles -->
                        <CheckBox IsChecked="{Binding MinimizeToTray}" Content="Simge durumuna küçültüldüğünde sistem tepsisine (Tray) gönder" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8" />
                        <CheckBox IsChecked="{Binding CloseToTray}" Content="Pencere kapatıldığında arka planda açık tut (Tray'e küçült)" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8" />
                        <CheckBox IsChecked="{Binding LaunchBigPicture}" Content="Steam'i her zaman Big Picture modunda başlat (-bigpicture)" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,8" />
                        <CheckBox IsChecked="{Binding LaunchSilent}" Content="Steam'i sessiz / arka planda başlat (-silent)" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,14" />

                        <!-- Global Args -->
                        <TextBlock Text="Genel Steam Başlatma Parametreleri:" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding GlobalLaunchArgs, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" />

                        <!-- Close Settings Button -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ToggleSettingsCommand}" Content="Kapat ve Kaydet" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- TOAST / SNACKBAR NOTIFICATION -->
            <Border Grid.Row="2"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16"
                    Background="#1f6feb"
                    CornerRadius="8"
                    Padding="16,10"
                    Visibility="{Binding IsStatusMessageVisible, Converter={StaticResource BoolToVis}}"
                    Panel.ZIndex="200">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="2" Opacity="0.5" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ️ " Foreground="#ffffff" FontSize="13" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#ffffff" FontSize="13" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
